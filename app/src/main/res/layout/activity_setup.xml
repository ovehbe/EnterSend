<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_intro" />

        <!-- Step 1 -->
        <LinearLayout style="@style/SetupStepHeader">
            <TextView android:id="@+id/step1_check" style="@style/SetupCheck" />
            <TextView style="@style/SetupStepTitle" android:text="@string/step1_title" />
        </LinearLayout>

        <TextView style="@style/SetupStepBody" android:text="@string/step1_body" />

        <Button
            android:id="@+id/step1_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step1_button" />

        <!-- Step 2 -->
        <LinearLayout style="@style/SetupStepHeader">
            <TextView android:id="@+id/step2_check" style="@style/SetupCheck" />
            <TextView style="@style/SetupStepTitle" android:text="@string/step2_title" />
        </LinearLayout>

        <TextView style="@style/SetupStepBody" android:text="@string/step2_body" />

        <TextView
            android:id="@+id/key_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/key_box"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:foreground="@drawable/focus_ring"
            android:gravity="center"
            android:minHeight="56dp"
            android:padding="12dp"
            android:text="@string/press_a_key" />

        <!-- Step 3 -->
        <LinearLayout style="@style/SetupStepHeader">
            <TextView android:id="@+id/step3_check" style="@style/SetupCheck" />
            <TextView style="@style/SetupStepTitle" android:text="@string/step3_title" />
        </LinearLayout>

        <TextView style="@style/SetupStepBody" android:text="@string/step3_body" />

        <TextView
            android:id="@+id/sent_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/key_box"
            android:padding="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/test_hint"
                android:importantForAutofill="no"
                android:inputType="textShortMessage|textMultiLine|textCapSentences"
                android:maxLines="4" />

            <ImageButton
                android:id="@+id/send_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/send"
                android:foreground="@drawable/focus_ring"
                android:src="@android:drawable/ic_menu_send" />
        </LinearLayout>

        <TextView
            android:id="@+id/step3_status"
            style="@style/SetupStepBody" />

        <Button
            android:id="@+id/done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/done" />
    </LinearLayout>
</ScrollView>
