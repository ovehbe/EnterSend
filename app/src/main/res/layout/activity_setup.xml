<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textAppearance="@style/TextAppearance.EnterSend.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_intro"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout style="@style/SetupStepHeader">
                    <TextView android:id="@+id/step1_check" style="@style/SetupCheck" />
                    <TextView style="@style/SetupStepTitle" android:text="@string/step1_title" />
                </LinearLayout>

                <TextView style="@style/SetupStepBody" android:text="@string/step1_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/step1_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="@drawable/focus_ring"
                    android:text="@string/step1_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout style="@style/SetupStepHeader">
                    <TextView android:id="@+id/step2_check" style="@style/SetupCheck" />
                    <TextView style="@style/SetupStepTitle" android:text="@string/step2_title" />
                </LinearLayout>

                <TextView style="@style/SetupStepBody" android:text="@string/step2_body" />

                <TextView
                    android:id="@+id/key_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/key_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="@drawable/focus_ring"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:padding="12dp"
                    android:text="@string/press_a_key"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout style="@style/SetupStepHeader">
                    <TextView android:id="@+id/step3_check" style="@style/SetupCheck" />
                    <TextView style="@style/SetupStepTitle" android:text="@string/step3_title" />
                </LinearLayout>

                <TextView style="@style/SetupStepBody" android:text="@string/step3_body" />

                <TextView
                    android:id="@+id/sent_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/key_box"
                    android:padding="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/test_hint"
                        app:boxBackgroundMode="outline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/message_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:foreground="@drawable/focus_ring"
                            android:importantForAutofill="no"
                            android:inputType="textShortMessage|textMultiLine|textCapSentences"
                            android:maxLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ImageButton (not Material IconButton): a11y exposes contentDescription
                         + clickable the same way 0.2.4 did, so Setup Enter can auto-find Send. -->
                    <ImageButton
                        android:id="@+id/send_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/colorPrimary"
                        android:contentDescription="@string/send"
                        android:foreground="@drawable/focus_ring"
                        android:src="@android:drawable/ic_menu_send"
                        android:tint="?attr/colorOnPrimary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/step3_status"
                    style="@style/SetupStepBody" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:foreground="@drawable/focus_ring"
            android:text="@string/done" />
    </LinearLayout>
</ScrollView>
