<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/chooser_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/chooser_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/prompt_body"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <Button
        android:id="@+id/chooser_teach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:text="@string/action_teach" />

    <Button
        android:id="@+id/chooser_later"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:text="@string/action_remind_later" />

    <Button
        android:id="@+id/chooser_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:text="@string/action_off_for_app" />

    <Button
        android:id="@+id/chooser_dont_ask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:text="@string/action_dont_ask" />
</LinearLayout>
