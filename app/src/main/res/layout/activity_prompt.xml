<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/prompt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EnterSend.Title" />

        <TextView
            android:id="@+id/prompt_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/prompt_body"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prompt_teach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/focus_ring"
            android:text="@string/action_teach" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prompt_later"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/focus_ring"
            android:text="@string/action_remind_later" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prompt_passthrough"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/focus_ring"
            android:text="@string/action_enable_default_enter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prompt_off"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/focus_ring"
            android:text="@string/action_off_for_app" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prompt_dont_ask"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/focus_ring"
            android:text="@string/action_dont_ask" />
    </LinearLayout>
</ScrollView>
