    <!-- First-run setup -->
    <string name="setup_title">Set up EnterSend</string>
    <string name="setup_intro">Three quick steps. You can do all of them with the keyboard: use the arrow keys or Tab to move, Enter to press.</string>
    <string name="step1_title">Turn on EnterSend</string>
    <string name="step1_body">EnterSend needs Accessibility access to see the text field and press the send button. It has no internet access.</string>
    <string name="step1_button">Open Accessibility settings</string>
    <string name="step2_title">Press Enter and Shift+Enter</string>
    <string name="step2_body">Move to the box below and press Enter, then Shift+Enter.</string>
    <string name="step2_status">Enter: %1$s     Shift+Enter: %2$s</string>
    <string name="step3_title">Try it</string>
    <string name="step3_body">Type a message and press Enter: it should be sent. Press Shift+Enter to start a new line.</string>
    <string name="step3_status">Enter sends: %1$s     Shift+Enter adds a line: %2$s</string>
